# Server-only TMDB credential (use exactly one of these; never NEXT_PUBLIC_)
TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=

# Licensed operator-owned media catalog, optional if data/own-sources.json is used
MEDIA_CATALOG_URL=
MEDIA_CATALOG_TOKEN=

# REQUIRED to allow playback sources (exact hostnames, separated by commas)
MEDIA_SOURCE_ALLOWED_HOSTS=

# Only for explicitly authorized HTTP-origin playback through Vercel
MEDIA_PROXY_ALLOWED_HOSTS=

# Disabled by default; enable only for content whose redistribution rights were checked
ENABLE_ARCHIVE_SOURCES=false


# Browser probes: ONLY your own HTTPS CORS-readable health JSON endpoints.
# Unset means no probes. Do not add arbitrary BDIX HTTP/private addresses.
NEXT_PUBLIC_BDIX_HEALTH_HOSTS=
NEXT_PUBLIC_BDIX_HEALTH_URLS=

# For separately authorized Type-A filename-only metadata indexing:
# BDIX_CRAWLER_RIGHTS_CONFIRMED=false
# BDIX_CRAWLER_ALLOWED_HOSTS=licensed-media.example.org
# TMDB_READ_ACCESS_TOKEN=(server-side enrichment only)
