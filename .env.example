# Server-side TMDB API key OR read access token; NEVER use NEXT_PUBLIC_.
TMDB_API_KEY=

# Optional licensed media catalog API. See README.md for its request/response contract.
MEDIA_CATALOG_URL=
MEDIA_CATALOG_TOKEN=

# Exact source origin hostnames (comma-separated). Required for remote catalog results.
MEDIA_SOURCE_ALLOWED_HOSTS=

# Exact HTTP proxy origin and HLS segment hostnames, comma-separated.
MEDIA_PROXY_ALLOWED_HOSTS=

# Off by default. Enable only after reviewing individual titles' distribution rights.
ENABLE_ARCHIVE_SOURCES=false
