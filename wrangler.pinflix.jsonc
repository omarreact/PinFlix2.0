{
  "name": "pinflix-media-api",
  "main": "cloudflare/pinflix-media-worker.mjs",
  "compatibility_date": "2026-10-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pinflix-media"
    }
  ],
  "vars": {
    "CORS_ORIGINS": "https://pin-flix2-0.vercel.app,https://pinflix.pincodeit.com"
  }
}
